---
// 手續費試算器：拉桿選每月交易量，即時看折扣能省多少
---

<section class="calc" id="calc">
  <div class="wrap calc-in">
    <div class="calc-copy">
      <span class="eyebrow">互動試算</span>
      <h3>手續費折扣，一年能省多少？</h3>
      <p>以現貨單邊費率 0.1% 估算。拉動滑桿看看你的交易量下，推薦碼折扣的實際價值。</p>
    </div>
    <div class="calc-box">
      <label class="calc-label" for="vol">每月交易量（USDT）</label>
      <input type="range" id="vol" min="500" max="200000" step="500" value="10000" />
      <div class="calc-vol"><span id="vol-num">10,000</span> USDT / 月</div>
      <div class="calc-rows">
        <div class="calc-row">
          <span>無折扣，一年手續費</span>
          <strong id="fee-base">—</strong>
        </div>
        <div class="calc-row good">
          <span>綁推薦碼（約 20% 折扣）</span>
          <strong id="fee-20">—</strong>
        </div>
        <div class="calc-row best">
          <span>推薦碼 + 平台幣折抵（約 40%）</span>
          <strong id="fee-40">—</strong>
        </div>
      </div>
      <p class="calc-save">一年最多省下 <strong id="save-num">—</strong> USDT</p>
      <p class="calc-note">＊以 0.1% 單邊費率、每月買賣各一次估算，僅供概念參考；實際費率依平台、等級與活動而異。</p>
    </div>
  </div>
</section>

<script>
  const vol = document.getElementById("vol") as HTMLInputElement | null;
  if (vol) {
    const fmt = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 0 });
    const upd = () => {
      const v = Number(vol.value);
      // 每月買+賣 = 2 邊，0.1% 費率，12 個月
      const base = v * 2 * 0.001 * 12;
      const f20 = base * 0.8;
      const f40 = base * 0.6;
      document.getElementById("vol-num")!.textContent = fmt(v);
      document.getElementById("fee-base")!.textContent = fmt(base) + " U";
      document.getElementById("fee-20")!.textContent = fmt(f20) + " U";
      document.getElementById("fee-40")!.textContent = fmt(f40) + " U";
      document.getElementById("save-num")!.textContent = fmt(base - f40);
    };
    vol.addEventListener("input", upd);
    upd();
  }
</script>
