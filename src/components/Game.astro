---
import { PLATFORMS } from "../config";
interface Props { variant?: "hero" | "page" }
const { variant = "page" } = Astro.props;
const hot = PLATFORMS.filter((p) => p.hot).map((p) => ({ name: p.name, url: p.url, code: p.code, id: p.id }));
const ctaData = JSON.stringify(hot);
const shellStyle = variant === "hero"
  ? "height:clamp(320px,44vh,460px)"
  : "height:min(70vh,620px)";
---

<div id="game-shell" style={shellStyle}>
  <canvas id="game"></canvas>

  <div id="start-screen" class="overlay">
    <div class="ov-card">
      <div class="ov-glyph">₿</div>
      <h2>比特幣大作戰</h2>
      <p class="ov-sub">吃碎幣長大、躲開比你大的幣。<br>開局自動駕駛，動一下滑鼠就由你接手。</p>
      <button class="ov-btn primary" id="btn-start">開始遊戲</button>
    </div>
  </div>

  <div id="dead-screen" class="overlay" hidden>
    <div class="ov-card">
      <div class="ov-glyph dead">💀</div>
      <h2>你的 ₿ 被吃掉了</h2>
      <p class="ov-score">最終市值 <strong id="final-score">0</strong> ｜ 最佳 <strong id="best-score">0</strong></p>
      <p class="ov-joke" id="joke-line"></p>
      <a class="ov-btn cta" id="cta-link" href="#" target="_blank" rel="noopener noreferrer"></a>
      <div class="ov-actions">
        <button class="ov-btn primary" id="btn-retry">再玩一次</button>
        <a class="ov-btn ghost" href="/#deals">看活動</a>
      </div>
    </div>
  </div>

  <div id="hud" hidden>市值 <span id="hud-score">0</span></div>
  <div id="pilot-tip" hidden>🤖 自動駕駛中 — 移動滑鼠／按方向鍵／點一下 接手</div>
  <div id="swan-banner" hidden></div>
</div>

<style>
  #game-shell{position:relative;width:100%;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#0E1320;box-shadow:var(--shadow);touch-action:none}
  #game{display:block;width:100%;height:100%}
  .overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(14,19,32,.82);backdrop-filter:blur(4px);padding:20px;text-align:center}
  .overlay[hidden]{display:none!important}
  #pilot-tip[hidden],#hud[hidden]{display:none!important}
  .ov-card{max-width:340px}
  .ov-glyph{font-family:var(--serif);font-size:56px;color:var(--amber);line-height:1;margin-bottom:6px}
  .ov-glyph.dead{font-size:50px}
  .ov-card h2{font-family:var(--serif);font-weight:600;font-size:26px;color:#fff;margin:0 0 10px;letter-spacing:-.01em}
  .ov-sub{color:#B9C0CC;font-size:14.5px;line-height:1.6;margin:0 0 20px}
  .ov-score{font-family:var(--mono);color:#fff;font-size:14.5px;margin:0 0 12px}
  .ov-score strong{color:var(--amber)}
  .ov-joke{color:#B9C0CC;font-size:14px;line-height:1.6;margin:0 0 16px}
  .ov-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:11px;font-weight:700;font-size:15px;padding:12px 22px;cursor:pointer;font-family:var(--sans);transition:transform .15s ease}
  .ov-btn:hover{transform:translateY(-2px)}
  .ov-btn.primary{background:var(--cobalt);color:#fff}
  .ov-btn.cta{background:var(--amber);color:#231600;width:100%;margin-bottom:14px;font-size:15.5px}
  .ov-btn.ghost{background:rgba(255,255,255,.1);color:#fff}
  .ov-actions{display:flex;gap:10px;justify-content:center}
  #hud{position:absolute;top:12px;left:14px;font-family:var(--mono);font-size:13.5px;font-weight:600;color:#fff;background:rgba(0,0,0,.32);padding:6px 12px;border-radius:9px;pointer-events:none}
  #hud span{color:var(--amber)}
  #pilot-tip{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:12px;color:#fff;background:rgba(27,77,255,.85);padding:7px 14px;border-radius:99px;pointer-events:none;white-space:nowrap}
  #swan-banner{position:absolute;top:0;left:0;right:0;background:linear-gradient(90deg,#B4231D,#E0521B);color:#fff;font-weight:700;font-size:14px;text-align:center;padding:11px 14px;pointer-events:none;z-index:5;box-shadow:0 4px 16px rgba(0,0,0,.3);animation:swanIn .25s ease}
  @keyframes swanIn{from{transform:translateY(-100%)}to{transform:translateY(0)}}
  #swan-banner[hidden],#pilot-tip[hidden],#hud[hidden]{display:none!important}
  @media(prefers-reduced-motion:reduce){.ov-btn:hover{transform:none}}
</style>

<script type="application/json" id="cta-data" set:html={ctaData}></script>
<script is:inline>
(function(){
  var HOT = [];
  try{ HOT = JSON.parse(document.getElementById("cta-data").textContent||"[]"); }catch(e){}
  var JOKES = [
    "一個不小心，畢生積蓄變成別人的午餐。",
    "貪心想變大，結果連本金都沒了。很真實。",
    "歸零的速度比下跌還快，幣圈日常。",
    "別難過，真的比特幣隨時買得回來 👇",
    "你被爆倉了……喔不對，是被吃了。"
  ];

  var shell = document.getElementById("game-shell");
  var cv = document.getElementById("game");
  var ctx = cv.getContext("2d");
  var startScreen = document.getElementById("start-screen");
  var deadScreen = document.getElementById("dead-screen");
  var hud = document.getElementById("hud");
  var hudScore = document.getElementById("hud-score");
  var pilotTip = document.getElementById("pilot-tip");

  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 0;
  var WORLD = 3200;

  function resize(){
    var r = shell.getBoundingClientRect();
    W = r.width || 800; H = r.height || 460;
    cv.width = W * DPR; cv.height = H * DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  window.addEventListener("resize", resize); resize();

  function rand(a,b){ return a+Math.random()*(b-a); }
  function m2r(m){ return 4+Math.sqrt(m)*3.2; }
  function dist2(ax,ay,bx,by){ var dx=ax-bx,dy=ay-by; return dx*dx+dy*dy; }

  var player=null, foods=[], bots=[], running=false, userControlled=false;
  var target={x:0,y:0}, cam={x:0,y:0,s:1};

  var BOT_GLYPHS = ["\u039E","\u25CE","\u20AE","$","\u25C8","\u00A4"];
  var BOT_COLORS = ["#5B8DEF","#22B8A6","#8B7BEF","#EF6F6F","#3FA9F5","#E0a93f"];
  var IMMUNE_MS = 4000, GRACE_MS = 4000, BOT_MASS_CAP = 240;
  var nextSwan = 0;
  var SWANS = [
    "FTX 又暴雷了","川普發了一篇推文","某交易所無預警跑路","SEC 一紙訴狀","巨鯨倒貨砸盤","穩定幣脫鉤了","交易所被駭客提光","升息超出預期"
  ];

  function spawnFood(){ return { x:rand(0,WORLD), y:rand(0,WORLD), hue:rand(38,50) }; }
  function makeBot(mass, minDist){
    var i = (Math.random()*BOT_GLYPHS.length)|0;
    var x,y,tries=0;
    do { x=rand(0,WORLD); y=rand(0,WORLD); tries++; }
    while(player && dist2(x,y,player.x,player.y) < minDist*minDist && tries<60);
    return { x:x, y:y, mass:mass, tx:rand(0,WORLD), ty:rand(0,WORLD),
             glyph:BOT_GLYPHS[i], color:BOT_COLORS[i], retarget:0 };
  }

  function init(){
    player = { x:WORLD/2, y:WORLD/2, mass:22, born:performance.now() };
    target = { x:player.x, y:player.y };
    userControlled = false;
    foods = [];
    for(var i=0;i<300;i++) foods.push(spawnFood());
    for(var j=0;j<46;j++) foods.push({ x:WORLD/2+rand(-320,320), y:WORLD/2+rand(-320,320), hue:rand(38,50) });
    bots = [];
    for(var k=0;k<10;k++) bots.push(makeBot(rand(8,24), 600));      // 小幣（多數可以吃）
    for(var k2=0;k2<3;k2++) bots.push(makeBot(rand(40,62), 950));   // 中幣
    bots.push(makeBot(rand(90,120), 1500));                          // 1 顆大幣，遠遠生
    cam = { x:player.x, y:player.y, s:1 };
    pilotTip.hidden = false;
    nextSwan = performance.now() + rand(12000, 20000);
  }

  function triggerSwan(){
    var cut = rand(0.40, 0.60);
    var pct = Math.round(cut*100);
    var ev = SWANS[(Math.random()*SWANS.length)|0];
    player.mass = Math.max(12, player.mass*(1-cut));
    for(var i=0;i<bots.length;i++){ bots[i].mass = Math.max(6, bots[i].mass*(1-cut)); }
    var banner = document.getElementById("swan-banner");
    if(banner){
      banner.textContent = "🦢 黑天鵝！" + ev + "，全場暴跌 " + pct + "%";
      banner.hidden = false;
      clearTimeout(banner._t);
      banner._t = setTimeout(function(){ banner.hidden = true; }, 3200);
    }
    nextSwan = performance.now() + rand(15000, 26000);
  }

  function takeControl(){
    if(!userControlled){ userControlled = true; pilotTip.hidden = true; }
  }
  var pointer = { sx:0, sy:0, active:false };
  function setPointer(clientX, clientY){
    var r = cv.getBoundingClientRect();
    pointer.sx = clientX - r.left - W/2;
    pointer.sy = clientY - r.top - H/2;
    pointer.active = true;
  }
  cv.addEventListener("mousemove",function(e){ if(running){ takeControl(); setPointer(e.clientX,e.clientY); } });
  cv.addEventListener("pointerdown",function(e){ if(running){ takeControl(); setPointer(e.clientX,e.clientY); } });
  cv.addEventListener("touchmove",function(e){ if(!running) return; e.preventDefault(); var t=e.touches[0]; takeControl(); setPointer(t.clientX,t.clientY); },{passive:false});
  cv.addEventListener("touchstart",function(e){ if(!running) return; var t=e.touches[0]; takeControl(); setPointer(t.clientX,t.clientY); },{passive:true});

  var keys = {};
  window.addEventListener("keydown",function(e){
    var k=(e.key||"").toLowerCase();
    if(["arrowup","arrowdown","arrowleft","arrowright","w","a","s","d"].indexOf(k)>=0){
      if(running) takeControl();
      keys[k]=true; if(k.indexOf("arrow")===0) e.preventDefault();
    }
  });
  window.addEventListener("keyup",function(e){ keys[(e.key||"").toLowerCase()]=false; });

  function speedFor(mass){ return Math.max(3.0, 9.2 - Math.sqrt(mass)*0.14); }

  function autopilot(){
    var pr = m2r(player.mass);
    // 1) 附近有比我大的幣 → 反方向逃
    var threat=null, td=1e18;
    for(var i=0;i<bots.length;i++){
      var b=bots[i];
      if(b.mass > player.mass*1.1){
        var d2=dist2(player.x,player.y,b.x,b.y);
        if(d2<td){ td=d2; threat=b; }
      }
    }
    if(threat && td < (420+pr)*(420+pr)){
      var dx=player.x-threat.x, dy=player.y-threat.y, d=Math.hypot(dx,dy)||1;
      target.x = player.x + (dx/d)*420;
      target.y = player.y + (dy/d)*420;
      return;
    }
    // 2) 否則去吃最近的碎幣
    var best=null, bd=1e18;
    for(var f=0; f<foods.length; f++){
      var fd=dist2(player.x,player.y,foods[f].x,foods[f].y);
      if(fd<bd){ bd=fd; best=foods[f]; }
    }
    if(best){ target.x=best.x; target.y=best.y; }
  }

  function step(){
    var now = performance.now();
    if(!userControlled) autopilot();

    // 滑鼠：持續朝游標方向移動（不會走到一半停）
    if(userControlled && pointer.active){
      target.x = cam.x + pointer.sx/cam.s;
      target.y = cam.y + pointer.sy/cam.s;
    }
    // 鍵盤覆寫
    var kx=0, ky=0;
    if(keys["arrowleft"]||keys["a"]) kx-=1;
    if(keys["arrowright"]||keys["d"]) kx+=1;
    if(keys["arrowup"]||keys["w"]) ky-=1;
    if(keys["arrowdown"]||keys["s"]) ky+=1;
    if(kx||ky){ target.x = player.x + kx*260; target.y = player.y + ky*260; }

    var pr = m2r(player.mass);
    var dx = target.x-player.x, dy = target.y-player.y;
    var d = Math.hypot(dx,dy) || 1;
    var sp = speedFor(player.mass);
    if(d>6){ player.x += (dx/d)*sp; player.y += (dy/d)*sp; }
    player.x = Math.max(0,Math.min(WORLD,player.x));
    player.y = Math.max(0,Math.min(WORLD,player.y));

    for(var i=0;i<foods.length;i++){
      var f=foods[i];
      if(dist2(player.x,player.y,f.x,f.y) < pr*pr){ player.mass += 1.1; foods[i]=spawnFood(); }
    }

    var grace = now - player.born < GRACE_MS;
    var immune = now - player.born < IMMUNE_MS;

    // 黑天鵝事件
    if(running && now > nextSwan && !grace){ triggerSwan(); }

    for(var bi=0;bi<bots.length;bi++){
      var b=bots[bi]; var br=m2r(b.mass);
      var steerx=0, steery=0;
      // 對玩家：大的追、小的逃
      var dpx=player.x-b.x, dpy=player.y-b.y, pd=Math.hypot(dpx,dpy)||1;
      var chasingP=false;
      if(!grace && pd<300){
        if(b.mass > player.mass*1.1){ steerx=dpx/pd; steery=dpy/pd; chasingP=true; }
        else if(player.mass > b.mass*1.1){ steerx=-dpx/pd; steery=-dpy/pd; }
      }
      // 對其他幣：找最近、比自己小的去追捕
      if(steerx===0 && steery===0){
        var prey=null, prd=1e18;
        for(var pj=0;pj<bots.length;pj++){ if(pj===bi) continue; var ob=bots[pj];
          if(b.mass > ob.mass*1.25){ var od=dist2(b.x,b.y,ob.x,ob.y); if(od<prd && od<480*480){ prd=od; prey=ob; } } }
        if(prey){ var qx=prey.x-b.x, qy=prey.y-b.y, qd=Math.hypot(qx,qy)||1; steerx=qx/qd; steery=qy/qd; }
      }
      // 否則隨機遊走
      if(steerx===0 && steery===0){
        if(--b.retarget<=0 || dist2(b.x,b.y,b.tx,b.ty)<400){ b.tx=rand(0,WORLD); b.ty=rand(0,WORLD); b.retarget=120; }
        var tdx=b.tx-b.x, tdy=b.ty-b.y, tdd=Math.hypot(tdx,tdy)||1; steerx=tdx/tdd; steery=tdy/tdd;
      }
      var bsp=speedFor(b.mass)*(grace?0.4:(chasingP?0.78:0.92));
      b.x=Math.max(0,Math.min(WORLD,b.x+steerx*bsp));
      b.y=Math.max(0,Math.min(WORLD,b.y+steery*bsp));
      if(b.mass<BOT_MASS_CAP){
        for(var k3=0;k3<foods.length;k3+=2){ var ff=foods[k3]; if(dist2(b.x,b.y,ff.x,ff.y)<br*br){ b.mass+=1; foods[k3]=spawnFood(); } }
      }

      var collide = dist2(player.x,player.y,b.x,b.y);
      if(player.mass > b.mass*1.15 && collide < (pr-br*0.4)*(pr-br*0.4)){
        player.mass += b.mass*0.85; bots[bi]=makeBot(rand(8,34), 700);
      } else if(b.mass > player.mass*1.15 && collide < (br-pr*0.4)*(br-pr*0.4)){
        if(!immune) return die();
      }
    }

    // 幣吃幣：大的吃掉小的
    for(var a=0;a<bots.length;a++){
      for(var c=a+1;c<bots.length;c++){
        var ba=bots[a], bc=bots[c];
        var ra=m2r(ba.mass), rc=m2r(bc.mass);
        var dd=dist2(ba.x,ba.y,bc.x,bc.y);
        if(ba.mass > bc.mass*1.2 && dd < (ra-rc*0.4)*(ra-rc*0.4)){
          ba.mass += bc.mass*0.8; bots[c]=makeBot(rand(8,30), 600);
        } else if(bc.mass > ba.mass*1.2 && dd < (rc-ra*0.4)*(rc-ra*0.4)){
          bc.mass += ba.mass*0.8; bots[a]=makeBot(rand(8,30), 600);
        }
      }
    }

    var targetS = Math.max(0.42, Math.min(1.25, 22/Math.sqrt(player.mass)+0.18));
    cam.s += (targetS-cam.s)*0.06;
    cam.x += (player.x-cam.x)*0.12;
    cam.y += (player.y-cam.y)*0.12;
    hudScore.textContent = Math.floor(player.mass);
  }

  function drawBlob(x,y,r,color,glyph,isPlayer){
    ctx.beginPath(); ctx.fillStyle=color; ctx.arc(x,y,r,0,6.283); ctx.fill();
    ctx.lineWidth=Math.max(2,r*0.08); ctx.strokeStyle="rgba(255,255,255,"+(isPlayer?0.9:0.55)+")"; ctx.stroke();
    if(r>11){
      ctx.fillStyle = isPlayer ? "#231600" : "rgba(255,255,255,.92)";
      ctx.font="700 "+Math.min(r*1.1,40)+"px monospace";
      ctx.textAlign="center"; ctx.textBaseline="middle";
      ctx.fillText(glyph,x,y+1);
    }
  }

  function draw(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle="#0E1320"; ctx.fillRect(0,0,W,H);
    ctx.save();
    ctx.translate(W/2,H/2); ctx.scale(cam.s,cam.s); ctx.translate(-cam.x,-cam.y);
    ctx.strokeStyle="rgba(255,255,255,.04)"; ctx.lineWidth=1;
    for(var gx=0;gx<=WORLD;gx+=160){ ctx.beginPath(); ctx.moveTo(gx,0); ctx.lineTo(gx,WORLD); ctx.stroke(); }
    for(var gy=0;gy<=WORLD;gy+=160){ ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(WORLD,gy); ctx.stroke(); }
    ctx.strokeStyle="rgba(245,165,36,.25)"; ctx.lineWidth=4; ctx.strokeRect(0,0,WORLD,WORLD);
    for(var i=0;i<foods.length;i++){ var f=foods[i]; ctx.beginPath(); ctx.fillStyle="hsl("+f.hue+",90%,60%)"; ctx.arc(f.x,f.y,3.2,0,6.283); ctx.fill(); }
    for(var bi=0;bi<bots.length;bi++){ var b=bots[bi]; drawBlob(b.x,b.y,m2r(b.mass),b.color,b.glyph,false); }
    var pr0 = m2r(player.mass);
    if(running && performance.now() - player.born < IMMUNE_MS){
      var pulse = 1 + Math.sin(performance.now()/120)*0.12;
      ctx.beginPath(); ctx.strokeStyle="rgba(245,165,36,.55)"; ctx.lineWidth=4;
      ctx.arc(player.x,player.y,pr0*1.5*pulse,0,6.283); ctx.stroke();
    }
    drawBlob(player.x,player.y,pr0,"#F5A524","\u20BF",true);
    ctx.restore();
  }

  var raf;
  function loop(){
    if(!running) return;
    try { step(); } catch(err){ console.error("game step error:", err); }
    if(!running) return;
    try { draw(); } catch(err2){ console.error("game draw error:", err2); }
    raf=requestAnimationFrame(loop);
  }

  function start(){
    init(); running=true;
    startScreen.hidden=true; deadScreen.hidden=true; hud.hidden=false;
    var sb=document.getElementById("swan-banner"); if(sb) sb.hidden=true;
    cancelAnimationFrame(raf); loop();
  }

  function die(){
    running=false; cancelAnimationFrame(raf);
    try{ draw(); }catch(e){}
    var score=Math.floor(player.mass);
    var best=0; try{ best=parseInt(localStorage.getItem("btc_game_best")||"0",10)||0; }catch(e){}
    if(score>best){ best=score; try{ localStorage.setItem("btc_game_best",String(best)); }catch(e){} }
    document.getElementById("final-score").textContent=score;
    document.getElementById("best-score").textContent=best;
    document.getElementById("joke-line").textContent=JOKES[(Math.random()*JOKES.length)|0];
    var ex=HOT[(Math.random()*HOT.length)|0]||{name:"\u4ea4\u6613\u6240",url:"/#deals",id:"none"};
    var cta=document.getElementById("cta-link");
    cta.textContent="\u6c92\u4e86\uff1f\u53bb "+ex.name+" \u8cb7\u4e00\u9846\u771f\u7684 \u20BF \u2197";
    cta.href=ex.url; cta.setAttribute("data-track","game_death_cta:"+ex.id);
    hud.hidden=true; pilotTip.hidden=true;
    var sb=document.getElementById("swan-banner"); if(sb) sb.hidden=true;
    deadScreen.hidden=false;
  }

  document.getElementById("btn-start").addEventListener("click",start);
  document.getElementById("btn-retry").addEventListener("click",start);
})();
</script>
