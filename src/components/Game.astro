---
import { PLATFORMS } from "../config";
interface Props { variant?: "hero" | "page" }
const { variant = "page" } = Astro.props;
const hot = PLATFORMS.filter((p) => p.hot).map((p) => ({ name: p.name, url: p.url, code: p.code, id: p.id }));
const ctaData = JSON.stringify(hot);
const shellStyle = variant === "hero"
  ? "height:clamp(320px,44vh,460px)"
  : "height:min(70vh,620px)";
---

<div id="game-intro">
  <span class="gi-badge">🎮 比特幣大作戰</span>
  <span class="gi-item">🏆 目標：吃掉 ETH 大魔王</span>
  <span class="gi-sep"></span>
  <span class="gi-item">🍬 吃碎幣和小幣長大</span>
  <span class="gi-sep"></span>
  <span class="gi-item">⚠️ 躲開比你大的幣</span>
  <span class="gi-sep"></span>
  <span class="gi-item">🦢 小心黑天鵝事件</span>
  <a class="gi-full" href="https://fox-blockchain.com/play/">⛶ 全螢幕遊玩</a>
</div>

<div id="game-shell" style={shellStyle}>
  <canvas id="game"></canvas>

  <div id="start-screen" class="overlay">
    <div class="ov-card">
      <div class="ov-glyph">₿</div>
      <h2>比特幣大作戰</h2>
      <p class="ov-sub">吃幣長大、躲開大幣。終極目標：吃掉<b>以太幣大魔王 ETH</b>，登頂市值之王！<br>小心隨機降臨的黑天鵝事件。</p>
      <div class="ov-actions">
        <button class="ov-btn easy" id="btn-easy">簡易版</button>
        <button class="ov-btn primary" id="btn-normal">正常版</button>
      </div>
      <p class="ov-hint">簡易版：整體速度較慢，新手好上手</p>
    </div>
  </div>

  <div id="win-screen" class="overlay" hidden>
    <div class="ov-card">
      <div class="ov-glyph win">🏆</div>
      <h2>你登頂了！</h2>
      <p class="ov-sub">你吃掉了以太幣大魔王，成為市值最大的幣種 👑</p>
      <p class="ov-score">最終市值 <strong id="win-final">0</strong> ｜ 最佳 <strong id="win-best">0</strong></p>
      <a class="ov-btn cta" id="win-cta" href="#" target="_blank" rel="noopener noreferrer"></a>
      <div class="ov-actions">
        <button class="ov-btn primary" id="btn-winretry">再玩一次</button>
        <a class="ov-btn ghost" href="/#deals">看活動</a>
      </div>
    </div>
  </div>

  <div id="dead-screen" class="overlay" hidden>
    <div class="ov-card">
      <div class="ov-glyph dead">💀</div>
      <h2>你的 ₿ 被吃掉了</h2>
      <p class="ov-score">最終市值 <strong id="final-score">0</strong> ｜ 最佳 <strong id="best-score">0</strong></p>
      <p class="ov-joke" id="joke-line"></p>
      <a class="ov-btn cta" id="cta-link" href="#" target="_blank" rel="noopener noreferrer"></a>
      <div class="ov-actions">
        <button class="ov-btn primary" id="btn-retry">再玩一次</button>
        {variant === "hero"
          ? <a class="ov-btn ghost" href="/play/">⛶ 全螢幕</a>
          : <a class="ov-btn ghost" href="/#deals">看活動</a>}
      </div>
    </div>
  </div>

  <div id="hud" hidden>市值 <span id="hud-score">0</span></div>
  <div id="pilot-tip" hidden>🤖 自動導航中｜動一下滑鼠即可接手</div>
  <div id="swan-banner" hidden></div>
  <img id="event-media" alt="" hidden />
</div>

<style>
  #game-shell{position:relative;width:100%;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#0E1320;box-shadow:var(--shadow);touch-action:none}
  #game{display:block;width:100%;height:100%}
  .overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(14,19,32,.82);backdrop-filter:blur(4px);padding:20px;text-align:center}
  .overlay[hidden]{display:none!important}
  #pilot-tip[hidden],#hud[hidden]{display:none!important}
  .ov-card{max-width:340px}
  .ov-glyph{font-family:var(--serif);font-size:56px;color:var(--amber);line-height:1;margin-bottom:6px}
  .ov-glyph.dead{font-size:50px}
  .ov-glyph.win{font-size:54px}
  .ov-card h2{font-family:var(--serif);font-weight:600;font-size:26px;color:#fff;margin:0 0 10px;letter-spacing:-.01em}
  .ov-sub{color:#B9C0CC;font-size:14.5px;line-height:1.6;margin:0 0 20px}
  .ov-score{font-family:var(--mono);color:#fff;font-size:14.5px;margin:0 0 12px}
  .ov-score strong{color:var(--amber)}
  .ov-joke{color:#B9C0CC;font-size:14px;line-height:1.6;margin:0 0 16px}
  .ov-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:11px;font-weight:700;font-size:15px;padding:12px 22px;cursor:pointer;font-family:var(--sans);transition:transform .15s ease}
  .ov-btn:hover{transform:translateY(-2px)}
  .ov-btn.primary{background:var(--cobalt);color:#fff}
  .ov-btn.easy{background:#1f9d6b;color:#fff}
  .ov-btn.cta{background:var(--amber);color:#231600;width:100%;margin-bottom:14px;font-size:15.5px}
  .ov-btn.ghost{background:rgba(255,255,255,.1);color:#fff}
  .ov-actions{display:flex;gap:10px;justify-content:center}
  #hud{position:absolute;top:12px;left:14px;font-family:var(--mono);font-size:13.5px;font-weight:600;color:#fff;background:rgba(0,0,0,.32);padding:6px 12px;border-radius:9px;pointer-events:none}
  #hud span{color:var(--amber)}
  #game-intro{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;background:#141B2C;border:1px solid rgba(245,165,36,.25);border-radius:14px;padding:10px 16px;margin:0 0 12px}
  .gi-badge{font-weight:800;font-size:14px;white-space:nowrap;padding:6px 12px;border-radius:99px;background:linear-gradient(135deg,#F5A524,#E0821B);color:#231600}
  .gi-item{font-size:13px;font-weight:600;color:#C7CEDB;white-space:nowrap}
  .gi-sep{width:4px;height:4px;border-radius:50%;background:rgba(199,206,219,.35)}
  .gi-full{margin-left:auto;font-size:13px;font-weight:700;color:#F5A524;text-decoration:none;white-space:nowrap;padding:6px 12px;border:1px solid rgba(245,165,36,.45);border-radius:99px;transition:background .15s ease}
  .gi-full:hover{background:rgba(245,165,36,.12)}
  @media(max-width:640px){.gi-sep{display:none}.gi-full{margin-left:0}}
  #pilot-tip{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:12px;color:#fff;background:rgba(27,77,255,.85);padding:7px 14px;border-radius:99px;pointer-events:none;white-space:nowrap;max-width:calc(100% - 28px)}
  #swan-banner.up{background:linear-gradient(90deg,#0E7A4F,#16A34A)}
  #swan-banner{position:absolute;top:0;left:0;right:0;background:linear-gradient(90deg,#B4231D,#E0521B);color:#fff;font-weight:700;font-size:14px;text-align:center;padding:11px 14px;pointer-events:none;z-index:5;box-shadow:0 4px 16px rgba(0,0,0,.3);animation:swanIn .25s ease}
  @keyframes swanIn{from{transform:translateY(-100%)}to{transform:translateY(0)}}
  #swan-banner[hidden],#pilot-tip[hidden],#hud[hidden]{display:none!important}
  #event-media{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(58%,300px);border-radius:14px;border:3px solid #627EEA;box-shadow:0 10px 40px rgba(0,0,0,.55);pointer-events:none;z-index:6;animation:swanIn .25s ease}
  #event-media[hidden]{display:none!important}
  @media(prefers-reduced-motion:reduce){.ov-btn:hover{transform:none}}
</style>

<script type="application/json" id="cta-data" set:html={ctaData}></script>
<script is:inline>
(function(){
  var HOT = [];
  try{ HOT = JSON.parse(document.getElementById("cta-data").textContent||"[]"); }catch(e){}
  var JOKES = [
    "一個不小心，畢生積蓄變成別人的午餐。",
    "貪心想變大，結果連本金都沒了。很真實。",
    "歸零的速度比下跌還快，幣圈日常。",
    "別難過，真的比特幣隨時買得回來 👇",
    "你被爆倉了……喔不對，是被吃了。"
  ];

  var shell = document.getElementById("game-shell");
  var cv = document.getElementById("game");
  var ctx = cv.getContext("2d");
  var startScreen = document.getElementById("start-screen");
  var deadScreen = document.getElementById("dead-screen");
  var hud = document.getElementById("hud");
  var hudScore = document.getElementById("hud-score");
  var pilotTip = document.getElementById("pilot-tip");

  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 0;
  var WORLD = 3200;

  function resize(){
    var r = shell.getBoundingClientRect();
    W = r.width || 800; H = r.height || 460;
    cv.width = W * DPR; cv.height = H * DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  window.addEventListener("resize", resize); resize();

  function rand(a,b){ return a+Math.random()*(b-a); }
  function m2r(m){ return 4+Math.sqrt(m)*3.2; }
  function dist2(ax,ay,bx,by){ var dx=ax-bx,dy=ay-by; return dx*dx+dy*dy; }

  var player=null, foods=[], bots=[], running=false, userControlled=false;
  var target={x:0,y:0}, cam={x:0,y:0,s:1};

  var COINS = [
    {s:"SOL",c:"#14F195"},{s:"BNB",c:"#F3BA2F"},{s:"XRP",c:"#3B4A57"},{s:"ADA",c:"#0033AD"},
    {s:"DOGE",c:"#C2A633"},{s:"TRX",c:"#E50914"},{s:"LINK",c:"#2A5ADA"},{s:"AVAX",c:"#E84142"},
    {s:"DOT",c:"#E6007A"},{s:"MATIC",c:"#8247E5"},{s:"SHIB",c:"#F00500"},{s:"LTC",c:"#345D9D"},
    {s:"UNI",c:"#FF007A"},{s:"ATOM",c:"#2E3148"},{s:"NEAR",c:"#00C08B"},{s:"APT",c:"#1AC9B0"},
    {s:"ARB",c:"#28A0F0"},{s:"OP",c:"#FF0420"},{s:"SUI",c:"#4DA2FF"},{s:"PEPE",c:"#4CA24C"},
    {s:"FIL",c:"#0090FF"},{s:"INJ",c:"#00D2FF"},{s:"TON",c:"#0098EA"},{s:"XLM",c:"#6E4FD3"},
    {s:"BCH",c:"#0AC18E"},{s:"ICP",c:"#3B00B9"},{s:"HBAR",c:"#222222"},{s:"VET",c:"#15BDFF"}
  ];
  var IMMUNE_MS = 4000, GRACE_MS = 4000, BOT_MASS_CAP = 240;
  var nextSwan = 0, swanFx = null, shake = 0, swan168Done = false, firstSwan = true;
  var marketNext = 0, marketTurn = 0;
  var capBot = function(m){ return Math.min(m, 800); };
  // 黑天鵝事件池：每場遊戲每個事件只會出現一次
  var SWAN_POOL = [];
  var SWAN_EVENTS = [
    { id:"trump",    fx:"trump", banner:"川普發動關稅戰爭，全部幣種暴跌 44%！",
      apply:function(){ player.mass=Math.max(12,player.mass*0.56); eachBot(function(b){ if(!b.isBoss) b.mass=Math.max(6,b.mass*0.56); }); } },
    { id:"ftx",      fx:"ftx",   banner:"FTX 暴雷了，全場蒸發 40%！",
      apply:function(){ player.mass=Math.max(12,player.mass*0.6); eachBot(function(b){ if(!b.isBoss) b.mass=Math.max(6,b.mass*0.6); }); } },
    { id:"etf",      fx:"up",    banner:"比特幣現貨 ETF 通過，所有幣種上漲 10%！",
      apply:function(){ player.mass*=1.10; eachBot(function(b){ if(!b.isBoss) b.mass=capBot(b.mass*1.10); }); } },
    { id:"doge",     fx:"up",    banner:"馬斯克送狗狗幣上月球，DOGE 暴漲 300%！",
      apply:function(){ eachBot(function(b){ if(b.sym==="DOGE") b.mass=capBot(b.mass*4); }); showEventMedia("/doge.webp"); } },
    { id:"ada",      fx:"down",  banner:"ADA 創辦人說要休息一下，ADA 暴跌 69%！",
      apply:function(){ eachBot(function(b){ if(b.sym==="ADA") b.mass=Math.max(6,b.mass*0.31); }); showEventMedia("/ada.png"); } },
    { id:"sui",      fx:"up",    banner:"氣候異常全球下暴雨，SUI 暴漲 1111%！",
      apply:function(){ eachBot(function(b){ if(b.sym==="SUI") b.mass=capBot(b.mass*12.11); }); } },
    { id:"vitalik",  fx:"down",  banner:"Vitalik 交女友了，ETH 暴跌 6.9%！",
      apply:function(){ eachBot(function(b){ if(b.isBoss) b.mass=Math.max(200,b.mass*0.931); }); showEventMedia("/vitalik.gif"); } },
    { id:"altseason",fx:"up",    banner:"山寨季來了！比特幣以外全部暴漲 33%！",
      apply:function(){ eachBot(function(b){ if(!b.isBoss) b.mass=capBot(b.mass*1.33); }); } },
    { id:"clarity",  fx:"up",    banner:"Clarity Act 法案通過，比特幣大漲 20%！",
      apply:function(){ player.mass*=1.20; } }
  ];
  function eachBot(fn){ for(var i=0;i<bots.length;i++) fn(bots[i]); }

  // 川普頭像（迷因圖，之後把 /swan-trump.png 換成你的圖即可）
  var trumpImg = new Image();
  var trumpReady = false;
  trumpImg.onload = function(){ trumpReady = true; };
  trumpImg.src = "/swan-trump.png";

  function spawnFood(){ return { x:rand(0,WORLD), y:rand(0,WORLD), hue:rand(38,50) }; }
  function makeBot(mass, minDist){
    var co = COINS[(Math.random()*COINS.length)|0];
    var x,y,tries=0;
    do { x=rand(0,WORLD); y=rand(0,WORLD); tries++; }
    while(player && dist2(x,y,player.x,player.y) < minDist*minDist && tries<60);
    return { x:x, y:y, mass:mass, tx:rand(0,WORLD), ty:rand(0,WORLD),
             sym:co.s, color:co.c, retarget:0, spd:rand(0.55,1.35) };  // 速度隨機，有快有慢
  }
  function makeBoss(){
    var x,y,tries=0;
    do { x=rand(0,WORLD); y=rand(0,WORLD); tries++; }
    while(player && dist2(x,y,player.x,player.y) < 1700*1700 && tries<80);
    return { x:x, y:y, mass:1000, isBoss:true, sym:"ETH", color:"#627EEA",
             tx:rand(0,WORLD), ty:rand(0,WORLD), retarget:0, spd:0.5 };
  }

  function init(){
    player = { x:WORLD/2, y:WORLD/2, mass:22, born:performance.now(), hx:0, hy:-1 };
    target = { x:player.x, y:player.y };
    userControlled = false;
    foods = [];
    for(var i=0;i<340;i++) foods.push(spawnFood());
    for(var j=0;j<46;j++) foods.push({ x:WORLD/2+rand(-320,320), y:WORLD/2+rand(-320,320), hue:rand(38,50) });
    bots = [];
    for(var k=0;k<26;k++) bots.push(makeBot(rand(8,22), 520));      // 大量小幣（好吃）
    for(var k2=0;k2<8;k2++) bots.push(makeBot(rand(34,62), 820));   // 中幣
    for(var k3a=0;k3a<3;k3a++) bots.push(makeBot(rand(80,130), 1400)); // 大幣
    bots.push(makeBoss());                                           // 以太幣大魔王（固定 1000）
    cam = { x:player.x, y:player.y, s:1 };
    pilotTip.hidden = false;
    swanFx = null; shake = 0; swan168Done = false; firstSwan = true;
    SWAN_POOL = SWAN_EVENTS.slice();                                 // 重置：每場每事件只出現一次
    nextSwan = performance.now() + rand(18000, 26000);              // 第一次較早，確保看得到
    marketNext = performance.now() + rand(20000, 28000);            // 牛熊週期
    marketTurn = 0;
    var vg=document.getElementById("event-media"); if(vg) vg.hidden=true;
  }

  function showSwanBanner(text, up){
    var b = document.getElementById("swan-banner");
    if(!b) return;
    b.textContent = text; b.className = up ? "up" : ""; b.hidden = false;
    clearTimeout(b._t); b._t = setTimeout(function(){ b.hidden = true; }, 3000);
  }

  function showEventMedia(src){
    var g = document.getElementById("event-media");
    if(!g) return;
    var tried = false;
    g.onerror = function(){
      if(tried){ g.hidden = true; return; }
      tried = true;
      // 大小寫容錯：自動再試一次相反大小寫的檔名（例如 ada.png ↔ ADA.png）
      var i = src.lastIndexOf("/"); var dir = src.slice(0,i+1); var file = src.slice(i+1);
      var dot = file.lastIndexOf("."); var nm = file.slice(0,dot); var ext = file.slice(dot);
      g.src = dir + (nm===nm.toLowerCase() ? nm.toUpperCase() : nm.toLowerCase()) + ext;
    };
    g.hidden = false;
    g.src = src;
    clearTimeout(g._t); g._t = setTimeout(function(){ g.hidden = true; }, 2800);
  }

  // 市場週期事件：依序輪流觸發（與黑天鵝獨立）
  var MARKET_EVENTS = [
    { up:true,  banner:"\uD83D\uDC02 \u725B\u5E02\u4F86\u4E86\uFF01\u6240\u6709\u5E63\u7A2E\u66B4\u6F32 20%\uFF01",
      apply:function(){ player.mass*=1.20; eachBot(function(b){ if(!b.isBoss) b.mass=capBot(b.mass*1.20); }); } },
    { up:false, banner:"\uD83D\uDC3B \u718A\u5E02\u4F86\u4E86\uFF01\u6BD4\u7279\u5E63 -30%\uFF0C\u5176\u4ED6\u5E63\u7A2E -90%\uFF01",
      apply:function(){ player.mass=Math.max(12,player.mass*0.70); eachBot(function(b){ if(!b.isBoss) b.mass=Math.max(6,b.mass*0.10); }); } },
    { up:true,  banner:"\uD83D\uDCC8 \u5FAE\u7B56\u7565\u52A0\u502C\u6BD4\u7279\u5E63\uFF0CBTC \u4E0A\u6F32 1%\uFF01",
      apply:function(){ player.mass*=1.01; } },
    { up:false, banner:"\uD83D\uDCC9 \u5FAE\u7B56\u7565\u8CE3\u51FA\u6BD4\u7279\u5E63\uFF0CBTC \u66B4\u8DCC 10%\uFF01",
      apply:function(){ player.mass=Math.max(12,player.mass*0.90); } }
  ];

  function triggerMarket(){
    var ev = MARKET_EVENTS[marketTurn % MARKET_EVENTS.length]; marketTurn++;
    try{ ev.apply(); }catch(e){}
    showSwanBanner(ev.banner, ev.up);
    shake = ev.up ? 10 : 18;
    if(!swanFx){ swanFx = { type: ev.up?"up":"down", evObj:null, t0:performance.now(), dur:1600, applied:true, fromX:0, fromY:0, shards:null }; }
    marketNext = performance.now() + rand(22000, 32000);
  }

  function triggerSwan(){
    if(SWAN_POOL.length===0) return;                                 // 事件用完就不再出現
    var ev = SWAN_POOL.splice((Math.random()*SWAN_POOL.length)|0, 1)[0];
    swanFx = { type:ev.fx, evObj:ev, t0:performance.now(), dur:2800, applied:false,
               fromX:(Math.random()<0.5?-0.25:1.25), fromY:rand(0.1,0.9), shards:null };
    nextSwan = performance.now() + (firstSwan ? rand(28000, 42000) : rand(35000, 60000));
    firstSwan = false;
  }

  function applySwanCut(ev){
    try{ ev.apply(); }catch(e){}
    shake = 22;
    showSwanBanner("\uD83E\uDDA2 \u9ED1\u5929\u9D5D\uFF01" + ev.banner, ev.fx==="up");
  }

  function takeControl(){
    if(!userControlled){ userControlled = true; pilotTip.hidden = true; }
  }
  var pointer = { sx:0, sy:0, active:false };
  function setPointer(clientX, clientY){
    var r = cv.getBoundingClientRect();
    pointer.sx = clientX - r.left - W/2;
    pointer.sy = clientY - r.top - H/2;
    pointer.active = true;
  }
  cv.addEventListener("mousemove",function(e){ if(running){ takeControl(); setPointer(e.clientX,e.clientY); } });
  cv.addEventListener("pointerdown",function(e){ if(running){ takeControl(); setPointer(e.clientX,e.clientY); } });
  cv.addEventListener("touchmove",function(e){ if(!running) return; e.preventDefault(); var t=e.touches[0]; takeControl(); setPointer(t.clientX,t.clientY); },{passive:false});
  cv.addEventListener("touchstart",function(e){ if(!running) return; var t=e.touches[0]; takeControl(); setPointer(t.clientX,t.clientY); },{passive:true});

  var keys = {};
  window.addEventListener("keydown",function(e){
    var k=(e.key||"").toLowerCase();
    if(["arrowup","arrowdown","arrowleft","arrowright","w","a","s","d"].indexOf(k)>=0){
      if(running) takeControl();
      keys[k]=true; if(k.indexOf("arrow")===0) e.preventDefault();
    }
  });
  window.addEventListener("keyup",function(e){ keys[(e.key||"").toLowerCase()]=false; });

  var speedMul = 1;
  function speedFor(mass){ return (Math.max(2.1, 6.4 - Math.sqrt(mass)*0.1)) * speedMul; }

  function autopilot(){
    var pr = m2r(player.mass);
    // 1) 附近有比我大的幣 → 反方向逃
    var threat=null, td=1e18;
    for(var i=0;i<bots.length;i++){
      var b=bots[i];
      if(b.mass > player.mass*1.1){
        var d2=dist2(player.x,player.y,b.x,b.y);
        if(d2<td){ td=d2; threat=b; }
      }
    }
    if(threat && td < (420+pr)*(420+pr)){
      var dx=player.x-threat.x, dy=player.y-threat.y, d=Math.hypot(dx,dy)||1;
      target.x = player.x + (dx/d)*420;
      target.y = player.y + (dy/d)*420;
      return;
    }
    // 2) 否則去吃最近的碎幣
    var best=null, bd=1e18;
    for(var f=0; f<foods.length; f++){
      var fd=dist2(player.x,player.y,foods[f].x,foods[f].y);
      if(fd<bd){ bd=fd; best=foods[f]; }
    }
    if(best){ target.x=best.x; target.y=best.y; }
  }

  function step(){
    var now = performance.now();
    if(!userControlled) autopilot();

    // ── 想去的方向（游標 / 鍵盤 / 自動駕駛）──
    var wantx=0, wanty=0, haveDir=false;
    if(userControlled && pointer.active){
      var pl=Math.hypot(pointer.sx,pointer.sy);
      if(pl>12){ wantx=pointer.sx/pl; wanty=pointer.sy/pl; haveDir=true; }
    }
    var kx=0, ky=0;
    if(keys["arrowleft"]||keys["a"]) kx-=1;
    if(keys["arrowright"]||keys["d"]) kx+=1;
    if(keys["arrowup"]||keys["w"]) ky-=1;
    if(keys["arrowdown"]||keys["s"]) ky+=1;
    if(kx||ky){ var kl=Math.hypot(kx,ky)||1; wantx=kx/kl; wanty=ky/kl; haveDir=true; }
    if(!userControlled){ // 自動駕駛已設好 target
      var adx=target.x-player.x, ady=target.y-player.y, al=Math.hypot(adx,ady)||1;
      wantx=adx/al; wanty=ady/al; haveDir=true;
    }
    // 平滑轉向；沒有輸入就維持上一個方向（慣性，永遠不會停在半路）
    if(haveDir){ player.hx += (wantx-player.hx)*0.28; player.hy += (wanty-player.hy)*0.28; }
    var hl=Math.hypot(player.hx,player.hy)||1; player.hx/=hl; player.hy/=hl;

    var pr = m2r(player.mass);
    var sp = speedFor(player.mass);
    player.x = Math.max(0,Math.min(WORLD, player.x + player.hx*sp));
    player.y = Math.max(0,Math.min(WORLD, player.y + player.hy*sp));

    for(var i=0;i<foods.length;i++){
      var f=foods[i];
      if(dist2(player.x,player.y,f.x,f.y) < pr*pr){ player.mass += 1.1; foods[i]=spawnFood(); }
    }

    var grace = now - player.born < GRACE_MS;
    var immune = now - player.born < IMMUNE_MS;

    // 黑天鵝事件
    if(running && !swanFx && !grace){
      if(!swan168Done && player.mass >= 168){ swan168Done = true; triggerSwan(); }
      else if(now > nextSwan){ triggerSwan(); }
    }
    // 牛市 / 熊市 週期（與黑天鵝獨立，可同時發生）
    if(running && !grace && now > marketNext){ triggerMarket(); }
    if(swanFx){
      var se = now - swanFx.t0;
      var impactT = swanFx.type==="trump" ? 1050 : (swanFx.type==="ftx" ? 620 : 420);
      if(!swanFx.applied && se >= impactT){ swanFx.applied = true; applySwanCut(swanFx.evObj); }
      if(se > swanFx.dur) swanFx = null;
    }
    if(shake > 0.3) shake *= 0.9; else shake = 0;

    for(var bi=0;bi<bots.length;bi++){
      var b=bots[bi]; var br=m2r(b.mass);
      var steerx=0, steery=0;
      // 對玩家：大的追、小的逃
      var dpx=player.x-b.x, dpy=player.y-b.y, pd=Math.hypot(dpx,dpy)||1;
      var chasingP=false, fleeingP=false;
      if(!grace && pd<300){
        if(b.mass > player.mass*1.1){ steerx=dpx/pd; steery=dpy/pd; chasingP=true; }
        else if(player.mass > b.mass*1.1 && pd<170){ steerx=-dpx/pd; steery=-dpy/pd; fleeingP=true; }
      }
      // 對其他幣：找最近、比自己小的去追捕
      if(steerx===0 && steery===0){
        var prey=null, prd=1e18;
        for(var pj=0;pj<bots.length;pj++){ if(pj===bi) continue; var ob=bots[pj];
          if(b.mass > ob.mass*1.25){ var od=dist2(b.x,b.y,ob.x,ob.y); if(od<prd && od<480*480){ prd=od; prey=ob; } } }
        if(prey){ var qx=prey.x-b.x, qy=prey.y-b.y, qd=Math.hypot(qx,qy)||1; steerx=qx/qd; steery=qy/qd; }
      }
      // 否則隨機遊走
      if(steerx===0 && steery===0){
        if(--b.retarget<=0 || dist2(b.x,b.y,b.tx,b.ty)<400){ b.tx=rand(0,WORLD); b.ty=rand(0,WORLD); b.retarget=120; }
        var tdx=b.tx-b.x, tdy=b.ty-b.y, tdd=Math.hypot(tdx,tdy)||1; steerx=tdx/tdd; steery=tdy/tdd;
      }
      var bsp=speedFor(b.mass)*(grace?0.4:(chasingP?0.8:(fleeingP?0.62:0.9)))*(b.spd||1);
      b.x=Math.max(0,Math.min(WORLD,b.x+steerx*bsp));
      b.y=Math.max(0,Math.min(WORLD,b.y+steery*bsp));
      if(!b.isBoss && b.mass<BOT_MASS_CAP){
        for(var k3=0;k3<foods.length;k3+=2){ var ff=foods[k3]; if(dist2(b.x,b.y,ff.x,ff.y)<br*br){ b.mass+=1; foods[k3]=spawnFood(); } }
      }

      var collide = dist2(player.x,player.y,b.x,b.y);
      if(player.mass > b.mass*1.12 && collide < (pr+br*0.35)*(pr+br*0.35)){
        if(b.isBoss){ return win(); }                        // 吃掉以太幣 → 勝利！
        player.mass += b.mass*0.85; bots[bi]=makeBot(rand(8,30), 700);
      } else if(b.mass > player.mass*1.15 && collide < (br-pr*0.4)*(br-pr*0.4)){
        if(!immune) return die();
      }
    }

    // 幣吃幣：大的吃掉小的（魔王不參與）
    for(var a=0;a<bots.length;a++){
      for(var c=a+1;c<bots.length;c++){
        var ba=bots[a], bc=bots[c];
        if(ba.isBoss||bc.isBoss) continue;
        var ra=m2r(ba.mass), rc=m2r(bc.mass);
        var dd=dist2(ba.x,ba.y,bc.x,bc.y);
        if(ba.mass > bc.mass*1.2 && dd < (ra-rc*0.4)*(ra-rc*0.4)){
          ba.mass += bc.mass*0.8; bots[c]=makeBot(rand(8,30), 600);
        } else if(bc.mass > ba.mass*1.2 && dd < (rc-ra*0.4)*(rc-ra*0.4)){
          bc.mass += ba.mass*0.8; bots[a]=makeBot(rand(8,30), 600);
        }
      }
    }

    var targetS = Math.max(0.42, Math.min(1.25, 22/Math.sqrt(player.mass)+0.18));
    cam.s += (targetS-cam.s)*0.06;
    cam.x += (player.x-cam.x)*0.12;
    cam.y += (player.y-cam.y)*0.12;
    hudScore.textContent = Math.floor(player.mass);
  }

  function drawBlob(x,y,r,color,glyph,isPlayer){
    ctx.beginPath(); ctx.fillStyle=color; ctx.arc(x,y,r,0,6.283); ctx.fill();
    ctx.lineWidth=Math.max(2,r*0.08); ctx.strokeStyle="rgba(255,255,255,"+(isPlayer?0.9:0.55)+")"; ctx.stroke();
    if(r>11 && glyph){
      var len=(""+glyph).length;
      var fs=Math.min(r*1.15, r*1.7/Math.max(1,len*0.62), 38);
      ctx.fillStyle = isPlayer ? "#231600" : "rgba(255,255,255,.95)";
      ctx.font="700 "+fs+"px ui-sans-serif,system-ui,sans-serif";
      ctx.textAlign="center"; ctx.textBaseline="middle";
      ctx.fillText(glyph,x,y+1);
    }
  }

  function draw(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle="#0E1320"; ctx.fillRect(0,0,W,H);
    ctx.save();
    var shx=0, shy=0;
    if(shake>0){ shx=(Math.random()-0.5)*shake; shy=(Math.random()-0.5)*shake; }
    ctx.translate(W/2+shx,H/2+shy); ctx.scale(cam.s,cam.s); ctx.translate(-cam.x,-cam.y);
    ctx.strokeStyle="rgba(255,255,255,.04)"; ctx.lineWidth=1;
    for(var gx=0;gx<=WORLD;gx+=160){ ctx.beginPath(); ctx.moveTo(gx,0); ctx.lineTo(gx,WORLD); ctx.stroke(); }
    for(var gy=0;gy<=WORLD;gy+=160){ ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(WORLD,gy); ctx.stroke(); }
    ctx.strokeStyle="rgba(245,165,36,.25)"; ctx.lineWidth=4; ctx.strokeRect(0,0,WORLD,WORLD);
    for(var i=0;i<foods.length;i++){ var f=foods[i]; ctx.beginPath(); ctx.fillStyle="hsl("+f.hue+",90%,60%)"; ctx.arc(f.x,f.y,3.2,0,6.283); ctx.fill(); }
    for(var bi=0;bi<bots.length;bi++){ var b=bots[bi]; var brr=m2r(b.mass);
      if(b.isBoss){
        var gp=1+Math.sin(performance.now()/180)*0.06;
        ctx.beginPath(); ctx.strokeStyle="rgba(98,126,234,.55)"; ctx.lineWidth=8;
        ctx.arc(b.x,b.y,brr*1.18*gp,0,6.283); ctx.stroke();
      }
      drawBlob(b.x,b.y,brr,b.color,b.sym,false);
    }
    var pr0 = m2r(player.mass);
    if(running && performance.now() - player.born < IMMUNE_MS){
      var pulse = 1 + Math.sin(performance.now()/120)*0.12;
      ctx.beginPath(); ctx.strokeStyle="rgba(245,165,36,.55)"; ctx.lineWidth=4;
      ctx.arc(player.x,player.y,pr0*1.5*pulse,0,6.283); ctx.stroke();
    }
    drawBlob(player.x,player.y,pr0,"#F5A524","\u20BF",true);
    ctx.restore();

    if(swanFx) drawSwanFx(performance.now());
  }

  function drawSwanFx(now){
    var e = now - swanFx.t0;
    var cx = W/2, cy = H/2;
    if(swanFx.type==="trump"){
      var impactT=1050;
      if(e<impactT){ // 頭像球從邊緣高速衝向玩家
        var t=e/impactT;
        var sx=swanFx.fromX*W, sy=swanFx.fromY*H;
        var x=sx+(cx-sx)*t, y=sy+(cy-sy)*t;
        var rad=28+58*t;
        drawHeadBall(x,y,rad, t);
        // 拖尾
        ctx.globalAlpha=0.25; drawHeadBall(sx+(cx-sx)*Math.max(0,t-0.08), sy+(cy-sy)*Math.max(0,t-0.08), rad*0.9, t); ctx.globalAlpha=1;
      } else {
        var f=(e-impactT)/(swanFx.dur-impactT);
        // 衝擊白閃 + 頭像在中心彈開縮小
        ctx.fillStyle="rgba(255,80,40,"+(0.5*(1-f))+")"; ctx.fillRect(0,0,W,H);
        drawHeadBall(cx, cy-30*f, 86*(1-0.4*f), 1);
      }
    } else if(swanFx.type==="ftx"){
      var impT=620;
      if(e<impT){ var t2=e/impT; drawFTX(cx,cy, 0.4+1.2*t2, 1); }
      else {
        if(!swanFx.shards){ swanFx.shards=[]; for(var s=0;s<14;s++){ var an=rand(0,6.283); swanFx.shards.push({a:an,v:rand(3,9),rot:rand(-0.2,0.2)}); } }
        var f2=(e-impT)/(swanFx.dur-impT);
        ctx.fillStyle="rgba(220,40,30,"+(0.45*(1-f2))+")"; ctx.fillRect(0,0,W,H);
        var prog=(e-impT);
        for(var s2=0;s2<swanFx.shards.length;s2++){ var sh=swanFx.shards[s2];
          var dx=Math.cos(sh.a)*sh.v*prog*0.25, dy=Math.sin(sh.a)*sh.v*prog*0.25 + 0.0008*prog*prog;
          ctx.save(); ctx.globalAlpha=Math.max(0,1-f2); ctx.translate(cx+dx,cy+dy); ctx.rotate(sh.a+sh.rot*prog*0.02);
          ctx.fillStyle="#0E2C2A"; ctx.strokeStyle="#2BD4C4"; ctx.lineWidth=2;
          ctx.beginPath(); ctx.moveTo(-18,-14); ctx.lineTo(16,-8); ctx.lineTo(8,16); ctx.closePath(); ctx.fill(); ctx.stroke();
          ctx.restore();
        }
      }
    } else if(swanFx.type==="down"){ // 紅光暈 + 下墜紅箭頭
      var f3=e/swanFx.dur;
      var g=ctx.createRadialGradient(cx,cy,Math.min(W,H)*0.2,cx,cy,Math.max(W,H)*0.7);
      g.addColorStop(0,"rgba(200,30,30,0)"); g.addColorStop(1,"rgba(170,10,10,"+(0.5*(1-f3))+")");
      ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
      ctx.fillStyle="rgba(255,70,70,"+(0.8*(1-f3))+")"; ctx.font="900 64px sans-serif"; ctx.textAlign="center"; ctx.textBaseline="middle";
      for(var ai=0;ai<5;ai++){ var ax=(ai+0.5)*W/5; var ay=((e*0.5+ai*120)%(H+120))-60; ctx.fillText("▼",ax,ay); }
    } else { // up：綠光暈 + 上升綠箭頭
      var f4=e/swanFx.dur;
      var g2=ctx.createRadialGradient(cx,cy,Math.min(W,H)*0.2,cx,cy,Math.max(W,H)*0.7);
      g2.addColorStop(0,"rgba(20,180,90,0)"); g2.addColorStop(1,"rgba(10,140,70,"+(0.5*(1-f4))+")");
      ctx.fillStyle=g2; ctx.fillRect(0,0,W,H);
      ctx.fillStyle="rgba(60,230,140,"+(0.8*(1-f4))+")"; ctx.font="900 64px sans-serif"; ctx.textAlign="center"; ctx.textBaseline="middle";
      for(var au=0;au<5;au++){ var ux=(au+0.5)*W/5; var uy=H+60-((e*0.5+au*120)%(H+120)); ctx.fillText("▲",ux,uy); }
    }
  }

  function drawHeadBall(x,y,r,t){
    ctx.save();
    ctx.beginPath(); ctx.arc(x,y,r,0,6.283); ctx.closePath();
    ctx.fillStyle="#F5A524"; ctx.fill();
    ctx.save(); ctx.clip();
    if(trumpReady){ ctx.drawImage(trumpImg, x-r, y-r, r*2, r*2); }
    else { // 佔位：橘臉 + 黃髮 + TRUMP
      ctx.fillStyle="#E8A36B"; ctx.fillRect(x-r,y-r,2*r,2*r);
      ctx.fillStyle="#F4D35E"; ctx.fillRect(x-r,y-r,2*r,r*0.5);
      ctx.fillStyle="#231600"; ctx.font="700 "+(r*0.45)+"px sans-serif"; ctx.textAlign="center"; ctx.textBaseline="middle";
      ctx.fillText("TRUMP",x,y+r*0.4);
    }
    ctx.restore();
    ctx.lineWidth=Math.max(3,r*0.08); ctx.strokeStyle="#fff"; ctx.beginPath(); ctx.arc(x,y,r,0,6.283); ctx.stroke();
    ctx.restore();
  }

  function drawFTX(x,y,scale,alpha){
    ctx.save(); ctx.globalAlpha=alpha; ctx.translate(x,y); ctx.scale(scale,scale);
    ctx.fillStyle="#11A8A0"; ctx.font="900 90px sans-serif"; ctx.textAlign="center"; ctx.textBaseline="middle";
    ctx.fillText("FTX",0,0);
    ctx.restore();
  }

  var raf;
  function loop(){
    if(!running) return;
    try { step(); } catch(err){ console.error("game step error:", err); }
    if(!running) return;
    try { draw(); } catch(err2){ console.error("game draw error:", err2); }
    raf=requestAnimationFrame(loop);
  }

  function start(mode){
    if(mode==="easy") speedMul = 0.65;
    else if(mode==="normal") speedMul = 1;
    init(); running=true;
    startScreen.hidden=true; deadScreen.hidden=true; hud.hidden=false;
    var ws=document.getElementById("win-screen"); if(ws) ws.hidden=true;
    var sb=document.getElementById("swan-banner"); if(sb) sb.hidden=true;
    cancelAnimationFrame(raf); loop();
  }

  function die(){
    running=false; cancelAnimationFrame(raf);
    swanFx=null; shake=0;
    try{ draw(); }catch(e){}
    var score=Math.floor(player.mass);
    var best=0; try{ best=parseInt(localStorage.getItem("btc_game_best")||"0",10)||0; }catch(e){}
    if(score>best){ best=score; try{ localStorage.setItem("btc_game_best",String(best)); }catch(e){} }
    document.getElementById("final-score").textContent=score;
    document.getElementById("best-score").textContent=best;
    document.getElementById("joke-line").textContent=JOKES[(Math.random()*JOKES.length)|0];
    var ex=HOT[(Math.random()*HOT.length)|0]||{name:"\u4ea4\u6613\u6240",url:"/#deals",id:"none"};
    var cta=document.getElementById("cta-link");
    cta.textContent="\u6c92\u4e86\uff1f\u53bb "+ex.name+" \u8cb7\u4e00\u9846\u771f\u7684 \u20BF \u2197";
    cta.href=ex.url; cta.setAttribute("data-track","game_death_cta:"+ex.id);
    hud.hidden=true; pilotTip.hidden=true;
    var sb=document.getElementById("swan-banner"); if(sb) sb.hidden=true;
    var vg=document.getElementById("event-media"); if(vg) vg.hidden=true;
    deadScreen.hidden=false;
  }

  function win(){
    running=false; cancelAnimationFrame(raf);
    swanFx=null; shake=0;
    try{ draw(); }catch(e){}
    var score=Math.floor(player.mass);
    var best=0; try{ best=parseInt(localStorage.getItem("btc_game_best")||"0",10)||0; }catch(e){}
    if(score>best){ best=score; try{ localStorage.setItem("btc_game_best",String(best)); }catch(e){} }
    var fs=document.getElementById("win-final"); if(fs) fs.textContent=score;
    var bs=document.getElementById("win-best"); if(bs) bs.textContent=best;
    var ex=HOT[(Math.random()*HOT.length)|0]||{name:"\u4ea4\u6613\u6240",url:"/#deals",id:"none"};
    var wcta=document.getElementById("win-cta");
    if(wcta){ wcta.textContent="\u6211\u8981\u53bb "+ex.name+" \u8cb7\u4e00\u9846\u771f\u7684 \u20BF \u2197"; wcta.href=ex.url; wcta.setAttribute("data-track","game_win_cta:"+ex.id); }
    hud.hidden=true; pilotTip.hidden=true;
    var sb=document.getElementById("swan-banner"); if(sb) sb.hidden=true;
    var vg2=document.getElementById("event-media"); if(vg2) vg2.hidden=true;
    var ws=document.getElementById("win-screen"); if(ws) ws.hidden=false;
  }

  document.getElementById("btn-easy").addEventListener("click",function(){ start("easy"); });
  document.getElementById("btn-normal").addEventListener("click",function(){ start("normal"); });
  // 進頁面自動以「簡易版」開始示範（自動駕駛），玩家隨時可接手
  startScreen.hidden = true;
  start("easy");
  document.getElementById("btn-retry").addEventListener("click",start);
  var bw=document.getElementById("btn-winretry"); if(bw) bw.addEventListener("click",start);
})();
</script>
