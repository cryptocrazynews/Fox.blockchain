---
import { PLATFORMS, getPlatform } from "../config";
// 指定 platformId 顯示該平台；不指定則用第一個主打平台
interface Props { platformId?: string }
const { platformId } = Astro.props;
const p = getPlatform(platformId) ?? PLATFORMS.find((x) => x.hot) ?? PLATFORMS[0];
const uid = `copy-${p.id}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="cta">
  <span class="cta-lab">本站讀者優惠 · {p.type}</span>
  <h3>在 {p.name} 註冊，{p.benefit}</h3>
  <p class="sub">{p.activity}{p.activityNote ? `（${p.activityNote}）` : ""}</p>
  <div class="code-row">
    <span class="code-chip">{p.code}</span>
    <button class="copy-btn js-copy" type="button" data-code={p.code} id={uid}>
      <span aria-hidden="true">⧉</span> <span class="copy-label">複製優惠碼</span>
    </button>
    <a class="cta-go" href={p.url} data-track={`article_cta:${p.id}`} target="_blank" rel="noopener noreferrer">
      前往註冊 ↗
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".js-copy").forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", async () => {
      const code = btn.getAttribute("data-code") || "";
      try { await navigator.clipboard.writeText(code); }
      catch {
        const t = document.createElement("textarea");
        t.value = code; document.body.appendChild(t); t.select();
        document.execCommand("copy"); t.remove();
      }
      const label = btn.querySelector(".copy-label");
      if (label) {
        const prev = label.textContent;
        label.textContent = "已複製！";
        setTimeout(() => (label.textContent = prev), 1600);
      }
    });
  });
</script>
