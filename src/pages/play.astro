---
import Base from "../layouts/Base.astro";
import { PLATFORMS } from "../config";

// 死亡畫面導流用：主打交易所（隨機出一家）
const hot = PLATFORMS.filter((p) => p.hot).map((p) => ({ name: p.name, url: p.url, code: p.code, id: p.id }));
const ctaData = JSON.stringify(hot);

const desc = "幣圈版 agar.io！你是一顆小比特幣，吃碎幣長大、別被大幣吃掉。一個不小心，畢生積蓄變成別人的午餐。";
---

<Base title="比特幣大作戰" description={desc} path="/play/">
  <section style="padding:28px 0 16px">
    <div class="wrap">
      <span class="eyebrow">小遊戲</span>
      <h1 style="font-family:var(--serif);font-weight:600;font-size:clamp(28px,5vw,42px);letter-spacing:-.02em;margin:10px 0 6px">比特幣大作戰 ₿</h1>
      <p style="color:var(--slate);max-width:52ch;margin:0">吃掉碎幣和比你小的幣，越長越大；碰到比你大的幣，你就被吃光歸零。看你能養多大一顆比特幣。</p>
    </div>
  </section>

  <div class="wrap" style="padding-bottom:40px">
    <div id="game-shell">
      <canvas id="game"></canvas>

      <!-- 開始畫面 -->
      <div id="start-screen" class="overlay">
        <div class="ov-card">
          <div class="ov-glyph">₿</div>
          <h2>比特幣大作戰</h2>
          <p class="ov-sub">移動滑鼠（手機用手指）控制方向。<br>吃小的、躲大的，活下來。</p>
          <button class="ov-btn primary" id="btn-start">開始遊戲</button>
          <p class="ov-hint">⌨️ 滑鼠移動 ／ 📱 手指拖曳</p>
        </div>
      </div>

      <!-- 死亡畫面 -->
      <div id="dead-screen" class="overlay" hidden>
        <div class="ov-card">
          <div class="ov-glyph dead">💀</div>
          <h2>你的 ₿ 被吃掉了</h2>
          <p class="ov-score">最終市值 <strong id="final-score">0</strong> ｜ 最佳 <strong id="best-score">0</strong></p>
          <p class="ov-joke" id="joke-line"></p>
          <a class="ov-btn cta" id="cta-link" href="#" target="_blank" rel="noopener noreferrer"></a>
          <div class="ov-actions">
            <button class="ov-btn primary" id="btn-retry">再玩一次</button>
            <a class="ov-btn ghost" href="/">回首頁</a>
          </div>
        </div>
      </div>

      <!-- HUD -->
      <div id="hud" hidden>市值 <span id="hud-score">0</span></div>
    </div>

    <p style="font-size:12.5px;color:#909aa8;margin:14px 0 0;line-height:1.7">
      ＊純娛樂遊戲，與真實投資績效無關。對手皆為電腦控制。加密貨幣投資具高度風險，請理性看待。
    </p>
  </div>
</Base>

<style>
  #game-shell{position:relative;width:100%;height:min(70vh,620px);border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#0E1320;box-shadow:var(--shadow);touch-action:none}
  #game{display:block;width:100%;height:100%}
  .overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(14,19,32,.82);backdrop-filter:blur(4px);padding:20px}
  .ov-card{text-align:center;max-width:380px}
  .ov-glyph{font-family:var(--serif);font-size:64px;color:var(--amber);line-height:1;margin-bottom:8px}
  .ov-glyph.dead{font-size:56px}
  .ov-card h2{font-family:var(--serif);font-weight:600;font-size:30px;color:#fff;margin:0 0 10px;letter-spacing:-.01em}
  .ov-sub{color:#B9C0CC;font-size:15px;line-height:1.6;margin:0 0 22px}
  .ov-score{font-family:var(--mono);color:#fff;font-size:15px;margin:0 0 14px}
  .ov-score strong{color:var(--amber)}
  .ov-joke{color:#B9C0CC;font-size:14.5px;line-height:1.6;margin:0 0 18px}
  .ov-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:11px;font-weight:700;font-size:15px;padding:13px 22px;cursor:pointer;font-family:var(--sans);transition:transform .15s ease}
  .ov-btn:hover{transform:translateY(-2px)}
  .ov-btn.primary{background:var(--cobalt);color:#fff}
  .ov-btn.cta{background:var(--amber);color:#231600;width:100%;margin-bottom:16px;font-size:16px}
  .ov-btn.ghost{background:rgba(255,255,255,.1);color:#fff}
  .ov-actions{display:flex;gap:10px;justify-content:center}
  .ov-hint{font-family:var(--mono);font-size:12px;color:#6b7280;margin:16px 0 0}
  #hud{position:absolute;top:14px;left:16px;font-family:var(--mono);font-size:14px;font-weight:600;color:#fff;background:rgba(0,0,0,.3);padding:7px 13px;border-radius:9px;pointer-events:none}
  #hud span{color:var(--amber)}
  @media(prefers-reduced-motion:reduce){.ov-btn:hover{transform:none}}
</style>

<script type="application/json" id="cta-data" set:html={ctaData}></script>
<script is:inline>
(function(){
  const HOT = (()=>{ try{ return JSON.parse(document.getElementById("cta-data").textContent||"[]"); }catch(e){ return []; } })();
  const JOKES = [
    "一個不小心，畢生積蓄變成別人的午餐。",
    "貪心想變大，結果連本金都沒了。很真實。",
    "歸零的速度比下跌還快，幣圈日常。",
    "別難過，真的比特幣隨時買得回來 👇",
    "你被爆倉了……喔不對，是被吃了。"
  ];

  const shell = document.getElementById("game-shell");
  const cv = document.getElementById("game");
  const ctx = cv.getContext("2d");
  const startScreen = document.getElementById("start-screen");
  const deadScreen = document.getElementById("dead-screen");
  const hud = document.getElementById("hud");
  const hudScore = document.getElementById("hud-score");

  let DPR = Math.min(window.devicePixelRatio || 1, 2);
  let W = 0, H = 0;
  const WORLD = 3200;

  function resize(){
    const r = shell.getBoundingClientRect();
    W = r.width; H = r.height;
    cv.width = W * DPR; cv.height = H * DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  window.addEventListener("resize", resize); resize();

  const rand = (a,b)=>a+Math.random()*(b-a);
  const m2r = (m)=>4+Math.sqrt(m)*3.2;
  const dist2 = (ax,ay,bx,by)=>{const dx=ax-bx,dy=ay-by;return dx*dx+dy*dy;};

  let player, foods, bots, running=false, target={x:0,y:0}, cam={x:0,y:0,s:1};

  const BOT_GLYPHS = ["Ξ","◎","₮","$","◈","¤"];
  const BOT_COLORS = ["#5B8DEF","#22B8A6","#8B7BEF","#EF6F6F","#3FA9F5","#E0a93f"];

  function spawnFood(){
    return { x:rand(0,WORLD), y:rand(0,WORLD), v:rand(1,2.4), hue:rand(38,50) };
  }
  function spawnBot(mass){
    const i = (Math.random()*BOT_GLYPHS.length)|0;
    let x,y,tries=0;
    do { x=rand(0,WORLD); y=rand(0,WORLD); tries++; }
    while(player && dist2(x,y,player.x,player.y) < 660*660 && tries<40);
    return { x, y, mass:mass||rand(8,140),
             tx:rand(0,WORLD), ty:rand(0,WORLD), glyph:BOT_GLYPHS[i], color:BOT_COLORS[i], retarget:0 };
  }

  function init(){
    player = { x:WORLD/2, y:WORLD/2, mass:22, born:performance.now() };
    target = { x:player.x, y:player.y };
    foods = []; for(let i=0;i<260;i++) foods.push(spawnFood());
    bots = []; for(let i=0;i<16;i++) bots.push(spawnBot());
    cam = { x:player.x, y:player.y, s:1 };
  }

  // input
  function setTargetFromEvent(clientX, clientY){
    const r = cv.getBoundingClientRect();
    const sx = clientX - r.left, sy = clientY - r.top;
    target.x = cam.x + (sx - W/2)/cam.s;
    target.y = cam.y + (sy - H/2)/cam.s;
  }
  cv.addEventListener("mousemove",(e)=>setTargetFromEvent(e.clientX,e.clientY));
  cv.addEventListener("touchmove",(e)=>{e.preventDefault();const t=e.touches[0];setTargetFromEvent(t.clientX,t.clientY);},{passive:false});
  cv.addEventListener("touchstart",(e)=>{const t=e.touches[0];setTargetFromEvent(t.clientX,t.clientY);},{passive:true});

  function speedFor(mass){ return Math.max(1.5, 5.6 - Math.sqrt(mass)*0.17); }

  function step(){
    // player move toward target
    const pr = m2r(player.mass);
    let dx = target.x-player.x, dy = target.y-player.y;
    const d = Math.hypot(dx,dy) || 1;
    const sp = speedFor(player.mass);
    if(d>2){ player.x += (dx/d)*sp; player.y += (dy/d)*sp; }
    player.x = Math.max(0,Math.min(WORLD,player.x));
    player.y = Math.max(0,Math.min(WORLD,player.y));

    // eat food
    for(let i=0;i<foods.length;i++){
      const f=foods[i];
      if(dist2(player.x,player.y,f.x,f.y) < pr*pr){ player.mass += 1.1; foods[i]=spawnFood(); }
    }

    // bots logic + interactions
    for(let i=0;i<bots.length;i++){
      const b=bots[i]; const br=m2r(b.mass);
      // simple AI: chase smaller player/flee bigger; else wander
      let steerx=0, steery=0;
      const dpx=player.x-b.x, dpy=player.y-b.y, pd=Math.hypot(dpx,dpy)||1;
      if(pd<320){
        if(b.mass > player.mass*1.15){ steerx=dpx/pd; steery=dpy/pd; }       // chase player
        else if(player.mass > b.mass*1.15){ steerx=-dpx/pd; steery=-dpy/pd; } // flee
      }
      if(steerx===0 && steery===0){
        if(--b.retarget<=0 || dist2(b.x,b.y,b.tx,b.ty)<400){ b.tx=rand(0,WORLD); b.ty=rand(0,WORLD); b.retarget=120; }
        const tdx=b.tx-b.x, tdy=b.ty-b.y, td=Math.hypot(tdx,tdy)||1; steerx=tdx/td; steery=tdy/td;
      }
      const bsp=speedFor(b.mass)*0.9;
      b.x=Math.max(0,Math.min(WORLD,b.x+steerx*bsp));
      b.y=Math.max(0,Math.min(WORLD,b.y+steery*bsp));
      // bot eats food
      if((i&1)===0){ for(let k=0;k<foods.length;k+=3){ const f=foods[k]; if(dist2(b.x,b.y,f.x,f.y)<br*br){ b.mass+=1; foods[k]=spawnFood(); } } }

      // player vs bot
      const collide = dist2(player.x,player.y,b.x,b.y);
      if(player.mass > b.mass*1.15 && collide < (pr-br*0.4)*(pr-br*0.4)){
        player.mass += b.mass*0.85; bots[i]=spawnBot(rand(8,40));
      } else if(b.mass > player.mass*1.15 && collide < (br-pr*0.4)*(br-pr*0.4)){
        if(performance.now() - player.born > 1800) return die();
      }
    }

    // camera follow + zoom
    const targetS = Math.max(0.42, Math.min(1.25, 22/Math.sqrt(player.mass)+0.18));
    cam.s += (targetS-cam.s)*0.06;
    cam.x += (player.x-cam.x)*0.12;
    cam.y += (player.y-cam.y)*0.12;

    hudScore.textContent = Math.floor(player.mass);
  }

  function draw(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle="#0E1320"; ctx.fillRect(0,0,W,H);
    ctx.save();
    ctx.translate(W/2,H/2); ctx.scale(cam.s,cam.s); ctx.translate(-cam.x,-cam.y);

    // grid
    ctx.strokeStyle="rgba(255,255,255,.04)"; ctx.lineWidth=1;
    const grid=160;
    for(let gx=0;gx<=WORLD;gx+=grid){ ctx.beginPath(); ctx.moveTo(gx,0); ctx.lineTo(gx,WORLD); ctx.stroke(); }
    for(let gy=0;gy<=WORLD;gy+=grid){ ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(WORLD,gy); ctx.stroke(); }
    // border
    ctx.strokeStyle="rgba(245,165,36,.25)"; ctx.lineWidth=4; ctx.strokeRect(0,0,WORLD,WORLD);

    // food
    for(let i=0;i<foods.length;i++){ const f=foods[i];
      ctx.beginPath(); ctx.fillStyle=`hsl(${f.hue},90%,60%)`; ctx.arc(f.x,f.y,3.2,0,6.283); ctx.fill();
    }

    // bots
    for(let i=0;i<bots.length;i++){ const b=bots[i]; drawBlob(b.x,b.y,m2r(b.mass),b.color,b.glyph); }

    // player (bitcoin)
    const pr0 = m2r(player.mass);
    if(running && performance.now() - player.born < 1800){
      const pulse = 1 + Math.sin(performance.now()/120)*0.12;
      ctx.beginPath(); ctx.strokeStyle="rgba(245,165,36,.55)"; ctx.lineWidth=4;
      ctx.arc(player.x,player.y,pr0*1.5*pulse,0,6.283); ctx.stroke();
    }
    drawBlob(player.x,player.y,pr0,"#F5A524","₿",true);

    ctx.restore();
  }

  function drawBlob(x,y,r,color,glyph,isPlayer){
    ctx.beginPath(); ctx.fillStyle=color; ctx.arc(x,y,r,0,6.283); ctx.fill();
    ctx.lineWidth=Math.max(2,r*0.08); ctx.strokeStyle="rgba(255,255,255,"+(isPlayer?.9:.55)+")"; ctx.stroke();
    if(r>11){
      ctx.fillStyle = isPlayer ? "#231600" : "rgba(255,255,255,.92)";
      ctx.font=`700 ${Math.min(r*1.1,40)}px var(--mono,monospace)`;
      ctx.textAlign="center"; ctx.textBaseline="middle";
      ctx.fillText(glyph,x,y+1);
    }
  }

  let raf;
  function loop(){ if(!running) return; step(); draw(); raf=requestAnimationFrame(loop); }

  function start(){
    init(); running=true;
    startScreen.hidden=true; deadScreen.hidden=true; hud.hidden=false;
    cancelAnimationFrame(raf); loop();
  }

  function die(){
    running=false; cancelAnimationFrame(raf); draw();
    const score=Math.floor(player.mass);
    let best=0; try{ best=parseInt(localStorage.getItem("btc_game_best")||"0",10)||0; }catch(e){}
    if(score>best){ best=score; try{ localStorage.setItem("btc_game_best",String(best)); }catch(e){} }
    document.getElementById("final-score").textContent=score;
    document.getElementById("best-score").textContent=best;
    document.getElementById("joke-line").textContent=JOKES[(Math.random()*JOKES.length)|0];
    // 隨機一家交易所導流
    const ex=HOT[(Math.random()*HOT.length)|0]||{name:"交易所",url:"/#deals",id:"none"};
    const cta=document.getElementById("cta-link");
    cta.textContent=`沒了？去 ${ex.name} 買一顆真的 ₿ ↗`;
    cta.href=ex.url; cta.setAttribute("data-track","game_death_cta:"+ex.id);
    hud.hidden=true; deadScreen.hidden=false;
  }

  document.getElementById("btn-start").addEventListener("click",start);
  document.getElementById("btn-retry").addEventListener("click",start);
})();
</script>
